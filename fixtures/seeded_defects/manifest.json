{
  "description": "Seeded-defect corpus for the [OM-DoD-002] M1.x validator gate. Each case applies a small, labeled mutation to a clean base payload and MUST raise the expected §H consistency code(s) with zero false negatives. The base is internally consistent, so any expected code that appears is caused by the seeded defect. Deterministic; no PDFs, no confidential OMs — safe to commit.",
  "base": "spec/samples/valid-stnl.json",
  "cases": [
    { "name": "w010-cap-vs-noi", "expect": ["OMW-W010"],
      "mutations": [{ "path": "/deal/capRate", "value": 0.09 }] },
    { "name": "w011-price-per-sf", "expect": ["OMW-W011"],
      "mutations": [{ "path": "/deal/pricePerSF", "value": 999 }] },
    { "name": "w012-proforma-no-asof", "expect": ["OMW-W012"],
      "mutations": [
        { "path": "/deal/noi", "delete": true },
        { "path": "/deal/noiType", "value": "pro-forma" },
        { "path": "/deal/noiAsOfDate", "delete": true }
      ] },
    { "name": "w013-cap-out-of-band", "expect": ["OMW-W013"],
      "mutations": [
        { "path": "/deal/noi", "delete": true },
        { "path": "/deal/noiType", "delete": true },
        { "path": "/deal/noiAsOfDate", "delete": true },
        { "path": "/deal/capRate", "value": 0.3 }
      ] },
    { "name": "w014-non-positive-noi", "expect": ["OMW-W014"],
      "mutations": [{ "path": "/deal/noi", "value": -5000 }] },
    { "name": "w020-year1-vs-noi", "expect": ["OMW-W020"],
      "mutations": [{ "path": "/lease/rentSchedule/0/annualRent", "value": 90000 }] },
    { "name": "w021-schedule-gap", "expect": ["OMW-W021"],
      "mutations": [{ "path": "/lease/rentSchedule/1/periodStart", "value": "2030-01-01" }] },
    { "name": "w022-schedule-overlap", "expect": ["OMW-W022"],
      "mutations": [{ "path": "/lease/rentSchedule/1/periodStart", "value": "2028-01-01" }] },
    { "name": "w023-escalation", "expect": ["OMW-W023"],
      "mutations": [{ "path": "/lease/rentSchedule/1/escalationFromPrior", "value": 0.25 }] },
    { "name": "w024-rent-psf", "expect": ["OMW-W024"],
      "mutations": [{ "path": "/lease/rentSchedule/0/rentPSF", "value": 99 }] },
    { "name": "w025-monthly-rent", "expect": ["OMW-W025"],
      "mutations": [{ "path": "/lease/rentSchedule/0/monthlyRent", "value": 5000 }] },
    { "name": "w026-period-outside-term", "expect": ["OMW-W026"],
      "mutations": [{ "path": "/lease/rentSchedule/0/periodStart", "value": "2010-01-01" }] },
    { "name": "w030-remaining-term", "expect": ["OMW-W030"],
      "mutations": [{ "path": "/lease/remainingTermMonths", "value": 12 }] },
    { "name": "w031-lease-term", "expect": ["OMW-W031"],
      "mutations": [{ "path": "/lease/termMonths", "value": 60 }] },
    { "name": "w032-future-asserted", "expect": ["OMW-W032"], "asOf": "2020-01-01",
      "mutations": [] },
    { "name": "w033-noi-asof-after-asserted", "expect": ["OMW-W033"],
      "mutations": [{ "path": "/deal/noiAsOfDate", "value": "2027-01-01" }] },
    { "name": "w034-expiration-before-commencement", "expect": ["OMW-W034"],
      "mutations": [{ "path": "/lease/expiration", "value": "2010-01-01" }] },
    { "name": "w040-net-lease-passthrough", "expect": ["OMW-W040"],
      "mutations": [{ "path": "/lease/landlordResponsibilities/taxes", "value": true }] },
    { "name": "w041-gross-no-responsibilities", "expect": ["OMW-W041"],
      "mutations": [{ "path": "/lease/leaseTypeAsserted", "value": "gross" }] },
    { "name": "w050-self-supersede", "expect": ["OMW-W050"], "selfSupersede": true,
      "mutations": [] },
    { "name": "w060-source-verified", "expect": ["OMW-W060"],
      "mutations": [{ "path": "/lease/rentSchedule/0/source", "value": "verified" }] }
  ]
}
