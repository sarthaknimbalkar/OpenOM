{
  "name": "openom-mcp-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public, deterministic, read-only openOM MCP server on Cloudflare Workers (om_read + om_validate via openom-js). Zero inference; serverless; not the home box.",
  "scripts": {
    "gen": "node scripts/gen-validator.mjs",
    "predeploy": "node scripts/gen-validator.mjs",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "openom-js": "file:../js"
  },
  "devDependencies": {
    "pdf-lib": "^1.17.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.0.0"
  }
}
