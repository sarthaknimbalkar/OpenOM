{
  "name": "openom-js",
  "version": "0.1.0",
  "description": "openOM TypeScript reference implementation (/js) — canonicalization, embed/read, validate. Deterministic; zero inference.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./widget/badge-core.js": {
      "types": "./dist/widget/badge-core.d.ts",
      "import": "./dist/widget/badge-core.js"
    }
  },
  "files": [
    "dist/src",
    "dist/widget",
    "README.md"
  ],
  "keywords": [
    "openom",
    "offering-memorandum",
    "cre",
    "json-ld",
    "pdf",
    "factur-x"
  ],
  "homepage": "https://github.com/sarthaknimbalkar/OpenOM/tree/main/js",
  "repository": {
    "type": "git",
    "url": "https://github.com/sarthaknimbalkar/OpenOM.git",
    "directory": "js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.widget.json",
    "build:widget": "node widget/build.mjs && node ../extension/scripts/assert-no-inference.mjs widget/dist",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@noble/ciphers": "^2.3.0",
    "@noble/hashes": "^1.8.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "canonicalize": "^2.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "tldts": "^7.4.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.0"
  }
}
