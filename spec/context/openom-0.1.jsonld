{
  "@context": {
    "@version": 1.1,
    "om": "https://verveliolabs.com/openom/ns/0.1#",
    "schema": "https://schema.org/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "RealEstateListing": "schema:RealEstateListing",
    "specVersion": "om:specVersion",
    "currency": "om:currency",

    "assertedBy": "om:assertedBy",
    "assertedDate": { "@id": "om:assertedDate", "@type": "xsd:date" },
    "broker": "om:broker",
    "brokerage": "om:brokerage",
    "license": "om:license",

    "property": "om:property",
    "address": "schema:address",
    "streetAddress": "schema:streetAddress",
    "addressLocality": "schema:addressLocality",
    "addressRegion": "schema:addressRegion",
    "postalCode": "schema:postalCode",
    "addressCountry": "schema:addressCountry",
    "geo": "schema:geo",
    "latitude": { "@id": "schema:latitude", "@type": "xsd:double" },
    "longitude": { "@id": "schema:longitude", "@type": "xsd:double" },
    "apn": "om:apn",
    "buildingSF": "om:buildingSF",
    "lotAcres": "om:lotAcres",
    "yearBuilt": "om:yearBuilt",
    "yearRenovated": "om:yearRenovated",

    "deal": "om:deal",
    "askingPrice": "om:askingPrice",
    "capRate": "om:capRate",
    "noi": "om:noi",
    "noiType": "om:noiType",
    "noiAsOfDate": { "@id": "om:noiAsOfDate", "@type": "xsd:date" },
    "pricePerSF": "om:pricePerSF",
    "status": "om:status",

    "lease": "om:lease",
    "tenantEntity": "om:tenantEntity",
    "guarantor": "om:guarantor",
    "name": "schema:name",
    "type": "om:guarantorType",
    "landlordResponsibilities": "om:landlordResponsibilities",
    "roof": "om:roof",
    "structure": "om:structure",
    "parking": "om:parking",
    "hvac": "om:hvac",
    "taxes": "om:taxes",
    "insurance": "om:insurance",
    "cam": "om:cam",
    "leaseTypeAsserted": "om:leaseTypeAsserted",
    "commencement": { "@id": "om:commencement", "@type": "xsd:date" },
    "expiration": { "@id": "om:expiration", "@type": "xsd:date" },
    "termMonths": "om:termMonths",
    "remainingTermMonths": "om:remainingTermMonths",

    "rentSchedule": { "@id": "om:rentSchedule", "@container": "@list" },
    "periodStart": { "@id": "om:periodStart", "@type": "xsd:date" },
    "periodEnd": { "@id": "om:periodEnd", "@type": "xsd:date" },
    "annualRent": "om:annualRent",
    "monthlyRent": "om:monthlyRent",
    "rentPSF": "om:rentPSF",
    "escalationFromPrior": "om:escalationFromPrior",
    "abatement": "om:abatement",
    "source": "om:source",

    "options": { "@id": "om:options", "@container": "@list" },
    "count": "om:count",
    "lengthYears": "om:lengthYears",
    "escalation": "om:escalation",

    "meta": "om:meta",
    "sourceDocHash": "om:sourceDocHash",
    "supersedes": "om:supersedes",
    "signature": "om:signature",
    "imageRights": "om:imageRights"
  }
}
