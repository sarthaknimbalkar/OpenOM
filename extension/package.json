{
  "name": "openom-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "openOM MV3 consumer-mode extension — detect, verify, view, publish. Zero inference.",
  "scripts": {
    "gen": "node scripts/gen-validator.mjs",
    "build": "node build.mjs",
    "package": "node scripts/package.mjs",
    "pretest:unit": "node scripts/gen-validator.mjs",
    "test:unit": "vitest run",
    "pretest:consumer": "node build.mjs",
    "test:consumer": "playwright test",
    "assert-no-inference": "node scripts/assert-no-inference.mjs dist"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.48.0",
    "@types/chrome": "^0.0.287",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsdom": "^25.0.0",
    "selfsigned": "^2.4.1",
    "typescript": "^5.7.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
