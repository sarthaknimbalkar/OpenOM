# openOM namespace headers for Apache / cPanel hosts (e.g. GoDaddy Linux hosting).
# Cloudflare Pages / Netlify use _headers + _redirects instead; all are generated so the
# site is host-portable. Keep in sync via gen_site.py.
# Canonical domain: 301 the www subdomain to the apex (matches _redirects on Pages).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.openom\.app$ [NC]
  RewriteRule ^(.*)$ https://openom.app/$1 [R=301,L]
</IfModule>
<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
  Header set Cache-Control "public, max-age=3600"
</IfModule>
<FilesMatch "^0\.1$">
  ForceType application/ld+json
</FilesMatch>
<FilesMatch "\.schema\.json$">
  ForceType application/schema+json
</FilesMatch>
